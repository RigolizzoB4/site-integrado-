# PowerMate Automation - Configurações de Ambiente
# Copie este arquivo para .env e configure as variáveis conforme necessário

# ==============================================
# CONFIGURAÇÕES DO KOMMO CRM
# ==============================================
# URL da API do Kommo (geralmente não precisa alterar)
KOMMO_API_URL=https://api.kommo.com/api/v4

# Credenciais da aplicação Kommo (obter no painel de desenvolvimento do Kommo)
KOMMO_CLIENT_ID=seu_client_id_aqui
KOMMO_CLIENT_SECRET=seu_client_secret_aqui
KOMMO_REDIRECT_URI=http://localhost:3000/callback

# Tokens de acesso (obtidos após autenticação OAuth)
KOMMO_ACCESS_TOKEN=seu_access_token_aqui
KOMMO_REFRESH_TOKEN=seu_refresh_token_aqui

# ==============================================
# CONFIGURAÇÕES DE MONITORAMENTO DE PASTA
# ==============================================
# Pasta para monitorar (adapte conforme seu sistema)
# Windows: C:\Users\%USERNAME%\OneDrive\PowerMate
# macOS/Linux: ~/OneDrive/PowerMate
WATCH_PATH=C:\Users\%USERNAME%\OneDrive\PowerMate

# Delay em milissegundos antes de processar arquivo (evita arquivos em transferência)
PROCESS_DELAY=5000

# Tamanho máximo de arquivo em bytes (50MB = 52428800)
MAX_FILE_SIZE=52428800

# ==============================================
# CONFIGURAÇÕES DA INTERFACE WEB
# ==============================================
# Porta da interface web
WEB_PORT=3000

# Host da interface web (localhost para acesso local apenas)
WEB_HOST=localhost

# ==============================================
# CONFIGURAÇÕES DE LOG
# ==============================================
# Nível de log: error, warn, info, debug
LOG_LEVEL=info

# ==============================================
# CONFIGURAÇÕES DE NOTIFICAÇÃO (OPCIONAL)
# ==============================================
# Email SMTP para notificações (opcional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASS=sua_senha_de_app
EMAIL_FROM=powermate@b4trade.com
EMAIL_TO=admin@b4trade.com

# Webhook para notificações (opcional)
WEBHOOK_URL=https://hooks.slack.com/services/SEU/WEBHOOK/URL

# ==============================================
# CONFIGURAÇÕES AVANÇADAS
# ==============================================
# Modo de desenvolvimento (true/false)
NODE_ENV=production

# Timezone
TZ=America/Sao_Paulo